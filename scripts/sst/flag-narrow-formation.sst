// Narrow 0-5-2 Formation
// Flags all 7 heroes in a narrow formation for corridors and tight spaces.
// Heroes closest to one another are in nearby range, but avoids far more AoE than default flagging.
//
// Team: Fully ranged
// Area: Narrow spaces (dungeons, corridors)
//
// Clipboard import (paste into SST's Import field):
//   11 6tKWnhrZTy3m7rZmdtYm7n#HKuqqqqqq#zgxJ9GvSq#mxlWmyWSVeWnh_p2bwHuq#ygNbH1kqyBzPbt9GvOBq#ygNbHHMNNbHH2M2XG#yfAg0p2bPWv5kqyv_Lgt9GvOBq#ygNbwxkvOyyDPTSAp2bwHTd9GACh0PbHTMKgZ9GvOBq#ygNbHePX8AABP5KCp2bwHT...
//
// To regenerate: python3 tools/sst-import/sst_script_gen.py scripts/sst/flag-narrow-formation.sst --dry-run

script "Narrow Formation" {
    trigger: Hotkey
    canLaunchInParallel: false

    when {
        True_
    }

    then {
        // Clear any existing flags first
        SendChat(channel: All, message: /flag clear)
        Wait(100ms)

        // Outer left midliner
        FlagHero(degree: 270, distance: 253, hero: 1)
        Wait(50ms)
        // Inner left midliner
        FlagHero(degree: 223.86, distance: 227.55, hero: 2)
        Wait(50ms)
        // Middle midliner
        FlagHero(degree: 180, distance: 219.1, hero: 3)
        Wait(50ms)
        // Inner right midliner
        FlagHero(degree: 136.14, distance: 227.55, hero: 4)
        Wait(50ms)
        // Outer right midliner
        FlagHero(degree: 90, distance: 253, hero: 5)
        Wait(50ms)
        // Left backliner
        FlagHero(degree: 200.69, distance: 445.83, hero: 6)
        Wait(50ms)
        // Right backliner
        FlagHero(degree: 159.31, distance: 445.83, hero: 7)
    }
}
