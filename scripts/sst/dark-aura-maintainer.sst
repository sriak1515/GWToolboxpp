// Dark Aura Maintainer
// Maintains Dark Aura on the player during combat via a hero.
//
// Clipboard import (paste into SST's Import field):
//   11 6tAWnhki1nhaopaYm3tWmJnXne#Hbrbbbbbt9KAEgHtUfuAelbE4yfrwkquSf#zejfzfvWqqqq#zg3bbvCgd9KAAg0rd9Gzu#yfFfp2bSqqqq7HvfelbF2bHKqvxd9Gyqu#ygwd9
//
// To regenerate: python3 tools/sst-import/sst_script_gen.py scripts/sst/dark-aura-maintainer.sst --dry-run

script "Dark Aura Maintainer" {
    trigger: None
    canLaunchInParallel: true

    when {
        IsInCombat
        not PlayerHasBuff(Dark_Aura)
        HeroHasSkill(hero: NoHero, skill: Dark_Aura, requirement: ReadyToUse)
        Throttle(5000ms)
    }

    then {
        EnterCriticalSection
        StoreTarget(id: 1)
        ChangeTarget(sorting: AgentId, filter: Allegiance(Self))
        UseHeroSkill(hero: NoHero, skill: Dark_Aura)
        RestoreTarget(id: 1)
        LeaveCriticalSection
    }
}
